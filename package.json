{
	"name": "odilf.com",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "pnpm subset:fonts && vite dev",
		"build": "pnpm subset:fonts && pnpm copy:blog && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "pnpm subset:fonts && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "pnpm subset:fonts && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"fetch:projects": "tsx scripts/fetch-projects.ts",
		"fetch:pics": "tsx scripts/fetch-pics.ts",
		"copy:blog": "tsx scripts/copy-blog-assets.ts",
		"subset:fonts": "tsx scripts/subset-fonts.ts",
		"test:unit": "vitest",
		"test": "pnpm run test:unit -- --run"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource/iosevka": "^5.3.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/enhanced-img": "^1.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/hast": "^3.0.5",
		"@types/mdast": "^4.0.4",
		"@types/node": "^24",
		"@types/unist": "^3.0.3",
		"@vitest/browser-playwright": "^4.1.8",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"sharp": "^0.35.5",
		"subset-font": "^2.9.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*",
		"#routes/*": "./src/routes/*"
	},
	"dependencies": {
		"gray-matter": "^4.0.3",
		"js-yaml": "^5.4.3",
		"katex": "^0.19.0",
		"rehype-katex": "^7.0.1",
		"rehype-raw": "^7.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-gfm": "^4.0.1",
		"remark-math": "^6.0.0",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"smol-toml": "^1.9.0",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.1.0",
		"zod": "^4.6.5"
	}
}
