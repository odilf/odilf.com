# Immich album used by `pnpm fetch:pics` and the pics pages.
IMMICH_URL=http://192.168.0.40:2283
IMMICH_ALBUM_ID=your-album-id
IMMICH_API_KEY=your-api-key

# Markdown content directories, kept outside the repository.
ODILF_BLOG_PATH=/path/to/blog
ODILF_MEDIA_LOG_PATH=/path/to/media-log

# Only needed by `pnpm fetch:projects`.
GITHUB_TOKEN=your-github-token
